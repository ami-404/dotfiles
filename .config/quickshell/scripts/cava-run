#!/bin/bash

CONFIG="${XDG_RUNTIME_DIR:-/tmp}/quickshell-cava.ini"

cat > "$CONFIG" <<EOF
[general]
framerate = 24
bars = 16
autosens = 1

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
channels = stereo

[smoothing]
monstercat = 0
noise_reduction = 55
EOF

exec stdbuf -oL cava -p "$CONFIG"
