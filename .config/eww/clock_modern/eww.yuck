;; Time variable - updates every second
(defpoll day      :interval "2s" "date '+%^A'")
(defpoll month    :interval "2s" "date '+%^b %d,%Y'")
(defpoll time     :interval "1s" "date '+- %I:%M %p -'")

;; The visual layout of the clock
(defwidget clock_widget []
  (box :class "clock-box"
       :orientation "v"
       :space-evenly "false"
       :halign "center"
    (label :text day
           :show-truncated false
           :class "day"
           :xalign 0.5)
    (label :text month
           :show-truncated false
           :class "month"
           :xalign 0.5)
    (label :text time
           :show-truncated false
           :class "time"
           :xalign 0.5)))


;; The window configuration
(defwindow wallpaper_clock
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "13%"
                      :width "300px"
                      :height "100px"
                      :anchor "top center")
  :stacking "bottom"  ;; Keeps it behind windows
  :exclusive false    ;; Desktop windows shouldn't push other apps
  :focusable false
  (clock_widget))
