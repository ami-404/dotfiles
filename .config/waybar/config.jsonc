{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,
  "modules-left": [
    "custom/rofi",
    "custom/line",
    "hyprland/workspaces",
    "custom/line",
    "hyprland/language"
    // , "custom/line", 
    // "hyprland/window"
  ],
  "modules-center": ["clock", "idle_inhibitor"], // "custom/update",  "custom/screenrecording-indicator",
  "modules-right": [
    // "group/tray-expander",
    "memory",
    "cpu",
    "bluetooth",
    "custom/notifi",
    // "network",
    "tray",
    "backlight",
    "pulseaudio",
    "custom/power"
    // "battery"
  ],
  "hyprland/workspaces": {
    "on-click": "hyprctl dispatch workspace {id}",
    // "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = {id} })'",
    //
    // "on-scroll-up": "hl.dispatch(workspace e-1)",
    // "on-scroll-down": "hyprctl dispatch workspace e-1",
    "show-special": true,
    "format": "<sub>{icon}</sub>{windows}",
    "format-icons": {
      "special": "󰧾",
      "default": "",
      "active": "󱓻",
      "1": "١",
      "2": "٢",
      "3": "٣",
      "4": "٤",
      "5": "٥",
      "6": "٦",
      "7": "٧",
      "8": "٨",
      "9": "٩",
      "10": "١٠"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    },
    // "format-window-separator": "",
   "workspace-taskbar": {
        "enable": true,
        "update-active-window": true,
        "format": " {icon}{title:.0}",
        "icon-size": 12,
        // "icon-theme": [ "hicolor" ],
        // "app_ids-mapping": {
        //   "helium-browser": "helium"
        // },
        "on-click-window": "~/scripts/focus-window.sh {address} {button}"
    }  
	//    "window-rewrite-default": "",
	//    "window-rewrite": {
	//    "title<.*youtube.*>": "", // Windows whose titles contain "youtube"
	//    "class<firefox>": "", // Windows whose classes are "firefox"
	//    "class<firefox> title<.*github.*>": "", // Windows whose class is "firefox" and title contains "github". Note that "class" always comes first.
	//    "class<.*brave.*>": "",
	//    "kitty": "", // Windows that contain "foot" in either class or title. For optimization reasons, it will only match against a title if at least one other window explicitly matches against a title.
	//    "code": "󰨞",
	// },
  },
  "custom/rofi": {
    "format": "<span >󰣇 </span>",
    // "on-click": "~/.config/eww/dashboard/launch_dashboard",
    "on-click": "/home/ameen/.config/rofi/launchers/type-6/launcher.sh",
    "on-click-right": "qs -c my-shell ipc call overview toggle",
    "tooltip-format": "App launcher"
  },
  "custom/line": {
    "format": "<span >|</span>"
  },

  "custom/song": {
    "exec": "mpc current"
  },
  // "hyprland/language": {
  //   // "format": "{short}",
  //   "on-click": "hyprctl switchxkblayout usb-keyboard-usb-keyboard next"
  // },

  "hyprland/window": {},

  // "hyprland/language": {
  //        "format": "{icon}",
  //        "format-icon": {
  //            "us": "🇺🇸",
  //            "ua": "🇺🇦",
  //            "fr": "🇫🇷",
  //            "default": "" // Optional: for any other language not listed
  //        },
  //        // This tells Waybar to use hyprctl to switch layouts on click
  //        "on-click": "hyprctl dispatch keyboard-layout next"
  //    },

  // "custom/update": {
  //   "format": "",
  //   "exec": "omarchy-update-available",
  //   "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
  //   "tooltip-format": "Omarchy update available",
  //   "signal": 7,
  //   "interval": 3600
  // },

  "memory": {
    "format": "  ",
    "tooltip-format": "{}%"
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "on-click": "$TERMINAL -e btop"
  },
  "clock": {
    "format": "{:L%A %H:%M}",
    "format-alt": "{:L%d %B %a %Y}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month"
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "mode"
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
// "custom/cava": {
//     "exec": "cava -p ~/.config/cava/cava.conf | sed -u 's/;//g;s/0/0/g;s/1/1/g;s/2/2/g;s/3/3/g;s/4/4/g;s/5/5/g;s/6/6/g;s/7/7/g;s/8/8/g;s/9/9/g;'",
//     "format": "{}",
//     "tooltip": false
// },
  "custom/notifi": {
    "format": "{icon}",
    "format-icons": " ",
    "on-click": "qs -c my-shell ipc call notifications toggle"
    // "on-click": "swaync-client -t"
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "Disabled",
    "interval": 3,
    "spacing": 1,
    "on-click": "~/projects/cpp/wifi-menu/menu"
    // "on-click": "~/scripts/wifi-menu.sh"
    // "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": " ",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueberry"
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Playing at {volume}%",
    "tooltip-format-muted": "Muted",
    "scroll-step": 2,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "default": ["", " ", " "]
    }
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": "{icon} ",
    "tooltip-format": "Brightness {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },
  // "group/tray-expander": {
  //   "orientation": "inherit",
  //   "drawer": {
  //     "transition-duration": 600,
  //     "children-class": "tray-group-item"
  //   },
  //   "modules": ["custom/expand-icon", "tray"]
  // },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false
  },
  // "custom/screenrecording-indicator": {
  //   "on-click": "omarchy-cmd-screenrecord",
  //   "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
  //   "signal": 8,
  //   "return-type": "json"
  // },
  "custom/power": {
    "format": " 󰐥 ",
    "tooltip-format": "leave the mechine",
    "on-click": "qs -c my-shell ipc call powermenu toggle"
    // "on-click": "qs -c powermenu ipc call powermenu toggle"
    // "on-click": "wlogout"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 7
  }
}
